{
  "name": "@algorandfoundation/keystore-web",
  "version": "1.0.0-canary.6",
  "description": "Browser keystore implementation (WebCrypto + IndexedDB) for Algorand Providers.",
  "license": "Apache-2.0",
  "author": "Algorand Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorandfoundation/wallet-provider-extensions.git",
    "directory": "keystore/web"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage node_modules",
    "docs": "typedoc",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "bench": "vitest bench",
    "release": "package-releaser",
    "release:dry-run": "package-releaser --dry-run"
  },
  "dependencies": {
    "@algorandfoundation/dp256": "^1.1.0",
    "@algorandfoundation/keystore-core": ">=1.0.0-canary.5",
    "@algorandfoundation/wallet-provider": "^1.0.0-canary.5",
    "@algorandfoundation/xhd-wallet-api": "^2.0.0-canary.1",
    "@scure/bip39": "^1.5.0",
    "falcon-1024": "^0.2.0"
  },
  "peerDependencies": {
    "@algorandfoundation/log-store": "*",
    "@tanstack/store": "^0.11.2",
    "before-after-hook": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@algorandfoundation/log-store": {
      "optional": true
    }
  }
}
